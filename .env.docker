# Docker environment overrides for Etherno
# Copy to .env.docker or export these before running docker compose.
# docker-compose.yml already has safe defaults; edit here only if you need to change them.

# Host port exposed for the app (web). Avoid 80 if another app uses it (e.g. Todak-Attendance).
APP_PORT=8088

# Host port exposed for PostgreSQL. Avoid 5432 if another postgres is running on the host.
DB_PORT_EXPOSE=5433

# Laravel APP_URL used inside the container.
APP_URL=http://localhost:8088

# PostgreSQL credentials (used by both postgres service and Laravel app).
DB_DATABASE=etherno
DB_USERNAME=etherno
DB_PASSWORD=secret
